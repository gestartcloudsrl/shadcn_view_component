<%# SPIKE — Shape D: upstream's actual aria-variant markup, read off
    ui.shadcn.com rather than designed here.

    The popover is `role="dialog"`, not a listbox — which is what lets a text
    field and a listbox live in the same layer without the field being a child
    of the list. The trigger is a plain button announcing a listbox popup. The
    search field sits in a `select-input-wrapper` around the InputGroup this gem
    already ships, with the magnifier as an addon.

    Faithful on one point that matters: upstream's search input carries **no
    accessible name at all** — no aria-label, no aria-labelledby, no
    placeholder. It is reproduced that way on purpose, to find out whether
    copying upstream 1:1 would pass this project's own axe run. %>
<div data-slot="select" style="display:contents">
  <%= render(Shadcn::Select::Trigger::Component.new(
        role: nil, "aria-autocomplete": nil, "aria-haspopup": "listbox",
        "aria-expanded": "true", "aria-controls": "spike-d-list", class: "w-[220px]")) do |t| %>
    <% t.with_value { "Select country" } %>
  <% end %>

  <%= render(Shadcn::Select::Content::Component.new(
        hidden: false, role: "dialog", "aria-label": "Choose a country",
        tabindex: nil, class: "w-[220px]")) do %>
    <div data-slot="select-input-wrapper" class="p-1">
      <%= render(Shadcn::InputGroup::Component.new) do %>
        <input data-slot="select-input"
               type="text"
               aria-autocomplete="list"
               aria-controls="spike-d-list"
               aria-activedescendant="spike-d-opt-1"
               class="flex-1 bg-transparent px-2 py-1.5 text-sm outline-none">
        <%# Inline rather than `Icon::Component.new("search")`: the magnifier is
            not one of the eleven bundled icons, and an unknown name raises in
            test. A shipped searchable select would have to add it. %>
        <%= render(Shadcn::InputGroup::Addon::Component.new) do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" class="size-4" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        <% end %>
      <% end %>
    </div>

    <div id="spike-d-list" role="listbox" data-slot="select-list" aria-label="Countries">
      <%= render(Shadcn::Select::Item::Component.new(value: "ar", id: "spike-d-opt-1")) { "Argentina" } %>
      <%= render(Shadcn::Select::Item::Component.new(value: "it", id: "spike-d-opt-2")) { "Italy" } %>
    </div>
  <% end %>
</div>
