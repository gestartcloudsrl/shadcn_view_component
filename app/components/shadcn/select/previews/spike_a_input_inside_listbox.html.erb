<%# SPIKE — not a shipped preview. Shape A: the naive bolt-on. The search input
    is placed inside SelectContent, which is itself `role="listbox"`, so a
    textbox becomes a child of the listbox. No `data-controller` on the root, so
    nothing connects and the layer stays visible for axe. %>
<div data-slot="select" style="display:contents">
  <%= render(Shadcn::Select::Trigger::Component.new(
        "aria-label": "Favourite country", "aria-expanded": "true", "aria-controls": "spike-a-content", class: "w-[220px]")) do |t| %>
    <% t.with_value { "Select country" } %>
  <% end %>

  <%= render(Shadcn::Select::Content::Component.new(
        hidden: false, id: "spike-a-content", class: "w-[220px]")) do %>
    <input data-slot="select-input"
           type="text"
           aria-label="Search countries"
           aria-autocomplete="list"
           aria-controls="spike-a-content"
           aria-activedescendant="spike-a-opt-1"
           class="mb-1 w-full rounded-sm border border-input bg-transparent px-2 py-1.5 text-sm outline-none">
    <%= render(Shadcn::Select::Item::Component.new(value: "ar", id: "spike-a-opt-1")) { "Argentina" } %>
    <%= render(Shadcn::Select::Item::Component.new(value: "it", id: "spike-a-opt-2")) { "Italy" } %>
  <% end %>
</div>
