<%# SPIKE — not a shipped preview. Shape C: as B, but the trigger drops
    `role="combobox"` and becomes a plain button announcing a popup, leaving the
    search input as the only combobox-ish element. This is the shape closest to
    upstream's aria variant, and the one that costs us a divergence from the
    Radix markup we otherwise emit. %>
<div data-slot="select" style="display:contents">
  <%= render(Shadcn::Select::Trigger::Component.new(
        role: nil, "aria-autocomplete": nil, "aria-haspopup": "listbox",
        "aria-label": "Favourite country", "aria-expanded": "true", "aria-controls": "spike-c-list", class: "w-[220px]")) do |t| %>
    <% t.with_value { "Select country" } %>
  <% end %>

  <%= render(Shadcn::Select::Content::Component.new(
        hidden: false, role: nil, tabindex: nil, class: "w-[220px]")) do %>
    <input data-slot="select-input"
           type="text"
           aria-label="Search countries"
           aria-autocomplete="list"
           aria-controls="spike-c-list"
           aria-activedescendant="spike-c-opt-1"
           class="mb-1 w-full rounded-sm border border-input bg-transparent px-2 py-1.5 text-sm outline-none">
    <div id="spike-c-list" role="listbox" data-slot="select-list" aria-label="Countries">
      <%= render(Shadcn::Select::Item::Component.new(value: "ar", id: "spike-c-opt-1")) { "Argentina" } %>
      <%= render(Shadcn::Select::Item::Component.new(value: "it", id: "spike-c-opt-2")) { "Italy" } %>
    </div>
  <% end %>
</div>
