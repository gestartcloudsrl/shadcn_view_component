<div class="flex flex-col items-start gap-6">
  <%= render(Shadcn::ToggleGroup::Component.new(type: :multiple, variant: :outline)) do |g| %>
    <% %w[Bold Italic Underline].each do |label| %>
      <% g.with_item(value: label.downcase) { label } %>
    <% end %>
  <% end %>
  <%= render(Shadcn::ToggleGroup::Component.new(type: :single, spacing: 2, value: "center")) do |g| %>
    <% %w[Left Center Right].each do |label| %>
      <% g.with_item(value: label.downcase, pressed: label == "Center") { label } %>
    <% end %>
  <% end %>
</div>
