<%# Upstream's "Side": the same tooltip on each of the four edges, and the
    arrow that points back at the trigger from each.

    Room on every side on purpose. The popper flips a tooltip that will not fit
    — collision handling doing its job — so a cramped page shows four tooltips
    on top and says nothing about `side:`. %>
<div class="flex h-72 items-center justify-center gap-16 px-24">
  <% %i[top right bottom left].each do |side| %>
    <%= render(Shadcn::Tooltip::Component.new) do |t| %>
      <% t.with_trigger(class: Shadcn::Button::Component.variant_classes(variant: :outline)) { side.to_s.capitalize } %>
      <% t.with_tooltip_content(side:) { "On the #{side}" } %>
    <% end %>
  <% end %>
</div>
