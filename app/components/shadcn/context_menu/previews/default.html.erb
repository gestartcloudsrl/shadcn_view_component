<%# Right-click the dashed area. The trigger has no classes of its own upstream
    — it is a region rather than a control — so the border here is the caller's,
    which is the only way to see where the region is.

    Everything below the trigger is the dropdown menu's, restamped: same items,
    same submenu, same checkbox and radio behaviour, same controller. %>
<div class="flex h-72 items-start justify-center pt-6">
  <%= render(Shadcn::ContextMenu::Component.new) do |menu| %>
    <% menu.with_trigger(class: "flex h-40 w-72 items-center justify-center rounded-md border border-dashed text-sm") do %>
      Right-click here
    <% end %>
    <% menu.with_menu_content(class: "w-52") do %>
      <%= render(Shadcn::ContextMenu::Item::Component.new) do %>
        Back
        <%= render(Shadcn::ContextMenu::Shortcut::Component.new) { "⌘[" } %>
      <% end %>
      <%= render(Shadcn::ContextMenu::Item::Component.new(disabled: true)) do %>
        Forward
        <%= render(Shadcn::ContextMenu::Shortcut::Component.new) { "⌘]" } %>
      <% end %>
      <%= render(Shadcn::ContextMenu::Separator::Component.new) %>
      <%= render(Shadcn::ContextMenu::Sub::Component.new) do |sub| %>
        <% sub.with_trigger { "More tools" } %>
        <% sub.with_menu_content do %>
          <%= render(Shadcn::ContextMenu::Item::Component.new) { "Save page" } %>
          <%= render(Shadcn::ContextMenu::Item::Component.new) { "Create shortcut" } %>
        <% end %>
      <% end %>
      <%= render(Shadcn::ContextMenu::Separator::Component.new) %>
      <%= render(Shadcn::ContextMenu::CheckboxItem::Component.new(checked: true)) { "Show bookmarks" } %>
      <%= render(Shadcn::ContextMenu::CheckboxItem::Component.new) { "Show full URLs" } %>
    <% end %>
  <% end %>
</div>
