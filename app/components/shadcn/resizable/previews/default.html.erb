<%# Upstream's own example. Panels and handles go in the block, in order — a
    group *is* `panel, handle, panel` — and sizes are percentages. %>
<%= render(Shadcn::Resizable::Component.new(class: "max-w-md rounded-lg border md:min-w-[450px]")) do %>
  <%= render(Shadcn::Resizable::Panel::Component.new(default_size: 50)) do %>
    <div class="flex h-[200px] items-center justify-center p-6">
      <span class="font-semibold">One</span>
    </div>
  <% end %>
  <%= render(Shadcn::Resizable::Handle::Component.new) %>
  <%= render(Shadcn::Resizable::Panel::Component.new(default_size: 50)) do %>
    <%= render(Shadcn::Resizable::Component.new(orientation: :vertical)) do %>
      <%= render(Shadcn::Resizable::Panel::Component.new(default_size: 25)) do %>
        <div class="flex h-full items-center justify-center p-6">
          <span class="font-semibold">Two</span>
        </div>
      <% end %>
      <%= render(Shadcn::Resizable::Handle::Component.new(orientation: :vertical)) %>
      <%= render(Shadcn::Resizable::Panel::Component.new(default_size: 75)) do %>
        <div class="flex h-full items-center justify-center p-6">
          <span class="font-semibold">Three</span>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
