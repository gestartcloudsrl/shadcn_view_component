<%# Upstream's own example: a bottom drawer with a header, a body and a footer.
    The handle above the header is what says it can be dragged. %>
<%= render(Shadcn::Drawer::Component.new) do |d| %>
  <% d.with_trigger(class: Shadcn::Button::Component.variant_classes(variant: :outline)) { "Open drawer" } %>
  <% d.with_dialog_content do |c| %>
    <% c.with_header do |h| %>
      <% h.with_title { "Move goal" } %>
      <% h.with_description { "Set your daily activity goal." } %>
    <% end %>
    <div class="p-4 pb-0">
      <p class="text-sm text-muted-foreground">
        Drag this panel downwards, or throw it, and it closes. Drag it up and it
        gives a little and comes back.
      </p>
    </div>
    <% c.with_footer do %>
      <%= render(Shadcn::Button::Component.new) { "Submit" } %>
      <%= render(Shadcn::Drawer::Close::Component.new(class: Shadcn::Button::Component.variant_classes(variant: :outline))) { "Cancel" } %>
    <% end %>
  <% end %>
<% end %>
