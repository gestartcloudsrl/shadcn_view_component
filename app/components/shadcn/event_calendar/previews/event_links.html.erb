<%# An event opening in a Sheet, and one going to its page.

    Both rows of the day list are links, because both events have a `url:`. What
    differs is only what the host put in `attributes:` — the first sends the
    response into the Sheet's frame and opens the Sheet, the second says nothing,
    so the browser follows the link. The `shadcn--dialog#open` action reaches the
    controller because the calendar is rendered inside the Sheet's root.

    The colour is `--chart-2`, a token every theme defines in both palettes, so
    this preview needs no stylesheet of its own. The route and the frame's
    markup are in `test/dummy`. %>
<%= render(Shadcn::Sheet::Component.new) do |sheet| %>
  <% sheet.with_dialog_content(side: :right, class: "w-full sm:max-w-md",
                               "aria-label": "Event detail") do %>
    <turbo-frame id="event" class="flex flex-col gap-3 p-4">
      <p class="text-sm text-muted-foreground">Pick an event.</p>
    </turbo-frame>
  <% end %>

  <%= render(Shadcn::EventCalendar::Component.new(
        reading: :weekly,
        month: Date.new(2026, 8, 1),
        selected: Date.new(2026, 8, 5),
        window: (7..19),
        day_url: ->(date) { "/calendar/days/#{date.iso8601}" },
        events: [
          { title: "Boiler service", starts_at: Time.zone.local(2026, 8, 5, 9),
            ends_at: Time.zone.local(2026, 8, 5, 11), color: "--chart-2",
            url: "/calendar/events/1",
            subtitle: "Via Roma 12",
            description: "Annual service, flue check and a new gasket.",
            done: true, attachment: true,
            assignees: [ { name: "Marco Rossi", status: :done },
                         { name: "Giulia Bianchi", status: :pending } ],
            attributes: { data: { turbo_frame: "event", action: "shadcn--dialog#open" } } },
          { title: "Flue inspection", starts_at: Time.zone.local(2026, 8, 5, 13),
            ends_at: Time.zone.local(2026, 8, 5, 14), color: :green,
            url: "/calendar/events/2", assignees: [ "Luca Verdi" ] }
        ]
      )) %>
<% end %>
