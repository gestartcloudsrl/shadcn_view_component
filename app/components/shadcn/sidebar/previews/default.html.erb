<%# shadcn's own `sidebar-demo`, read from the iframe it renders in —
    ui.shadcn.com/view/radix-nova/sidebar-demo — with `collapsible: :icon`,
    which is what that demo uses: collapsing leaves a rail of icons rather than
    sliding the whole panel away.

    The icons are inlined rather than bundled. `Icon::Component`'s PATHS holds
    the icons the *components* need; these are a demo's decoration, and putting
    eight of them into a library's payload for one preview is the wrong trade.
    Their paths were read from upstream's rendered demo rather than recalled.

    The Projects rows carry `tooltip:`, which is what labels their icons once
    the sidebar collapses. The Platform rows cannot: each is a Collapsible
    trigger wearing the menu button's classes rather than a MenuButton, so it
    takes a plain `title:` — the browser's own tooltip — instead. That
    difference is upstream's too, and the reason is the same on both sides. %>
<%
  icons = {
    "gallery-vertical-end" => %(<path d="M7 2h10"/><path d="M5 6h14"/><rect width="18" height="12" x="3" y="10" rx="2"/>),
    "square-terminal" => %(<path d="m7 11 2-2-2-2"/><path d="M11 13h4"/><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>),
    "bot" => %(<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>),
    "book-open" => %(<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>),
    "settings-2" => %(<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>),
    "frame" => %(<line x1="22" x2="2" y1="6" y2="6"/><line x1="22" x2="2" y1="18" y2="18"/><line x1="6" x2="6" y1="2" y2="22"/><line x1="18" x2="18" y1="2" y2="22"/>),
    "chart-pie" => %(<path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"/><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/>),
    "map" => %(<path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>),
  }

  glyph = ->(name, extra = nil) do
    tag.svg(
      icons.fetch(name).html_safe,
      xmlns: "http://www.w3.org/2000/svg", width: 24, height: 24,
      viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
      "stroke-width": 2, "stroke-linecap": "round", "stroke-linejoin": "round",
      class: [ "size-4 shrink-0", extra ].compact.join(" "), "aria-hidden": true
    )
  end

  platform = {
    "Playground" => [ "square-terminal", %w[History Starred Settings] ],
    "Models" => [ "bot", %w[Genesis Explorer Quantum] ],
    "Documentation" => [ "book-open", [ "Introduction", "Get Started", "Tutorials" ] ],
    "Settings" => [ "settings-2", %w[General Team Billing] ]
  }
  projects = [ [ "Design Engineering", "frame" ], [ "Sales & Marketing", "chart-pie" ], [ "Travel", "map" ] ]
%>
<%= render(Shadcn::Sidebar::Provider::Component.new) do %>
  <%= render(Shadcn::Sidebar::Component.new(collapsible: :icon)) do %>
    <%= render(Shadcn::Sidebar::Header::Component.new) do %>
      <%= render(Shadcn::Sidebar::Menu::Component.new) do %>
        <%= render(Shadcn::Sidebar::MenuItem::Component.new) do %>
          <%= render(Shadcn::DropdownMenu::Component.new) do |menu| %>
            <% menu.with_trigger(
                 class: Shadcn::Sidebar::MenuButton::Component.new(size: :lg).css_classes,
                 "data-size": "lg"
               ) do %>
              <div class="flex aspect-square size-8 shrink-0 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                <%= glyph.call("gallery-vertical-end") %>
              </div>
              <div class="grid flex-1 text-left text-sm leading-tight">
                <span class="truncate font-medium">Acme Inc</span>
                <span class="truncate text-xs">Enterprise</span>
              </div>
              <%= render(Shadcn::Icon::Component.new("chevrons-up-down", class: "ml-auto")) %>
            <% end %>
            <% menu.with_menu_content(class: "w-56") do %>
              <%= render(Shadcn::DropdownMenu::Label::Component.new) { "Teams" } %>
              <% [ "Acme Inc", "Acme Corp.", "Evil Corp." ].each do |team| %>
                <%= render(Shadcn::DropdownMenu::Item::Component.new) { team } %>
              <% end %>
              <%= render(Shadcn::DropdownMenu::Separator::Component.new) %>
              <%= render(Shadcn::DropdownMenu::Item::Component.new) { "Add team" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Shadcn::Sidebar::Content::Component.new) do %>
      <%= render(Shadcn::Sidebar::Group::Component.new) do %>
        <%= render(Shadcn::Sidebar::GroupLabel::Component.new) { "Platform" } %>
        <%= render(Shadcn::Sidebar::Menu::Component.new) do %>
          <% platform.each_with_index do |(section, (name, pages)), index| %>
            <%= render(Shadcn::Sidebar::MenuItem::Component.new) do %>
              <%= render(Shadcn::Collapsible::Component.new(open: index.zero?, class: "group/collapsible")) do %>
                <%# Neither slot is used, and that is deliberate. Slot content
                    renders before block content, so `with_panel` would put the
                    submenu above its own trigger; and the trigger has to *be*
                    the MenuButton, not a plain trigger wearing its classes,
                    because that is where `tooltip:` lives and a collapsed rail
                    of icons has nothing else to label it. Upstream composes it
                    the same way: `<CollapsibleTrigger asChild>
                    <SidebarMenuButton tooltip={…}>`. %>
                <%= render(Shadcn::Sidebar::MenuButton::Component.new(
                      tooltip: section,
                      "data-shadcn--collapsible-target": "trigger",
                      "data-action": "shadcn--collapsible#toggle",
                      "aria-expanded": index.zero?.to_s
                    )) do %>
                  <%= glyph.call(name) %>
                  <span><%= section %></span>
                  <%= render(Shadcn::Icon::Component.new(
                        "chevron-right",
                        class: "ml-auto transition-transform group-data-[state=open]/collapsible:rotate-90"
                      )) %>
                <% end %>

                <%= render(Shadcn::Collapsible::Content::Component.new) do %>
                  <%= render(Shadcn::Sidebar::MenuSub::Component.new) do %>
                    <% pages.each do |page| %>
                      <%= render(Shadcn::Sidebar::MenuSubItem::Component.new) do %>
                        <%= render(Shadcn::Sidebar::MenuSubButton::Component.new(href: "#")) do %>
                          <span><%= page %></span>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= render(Shadcn::Sidebar::Group::Component.new(class: "group-data-[collapsible=icon]:hidden")) do %>
        <%= render(Shadcn::Sidebar::GroupLabel::Component.new) { "Projects" } %>
        <%= render(Shadcn::Sidebar::Menu::Component.new) do %>
          <% projects.each do |(project, name)| %>
            <%= render(Shadcn::Sidebar::MenuItem::Component.new) do %>
              <%= render(Shadcn::Sidebar::MenuButton::Component.new(as: :a, href: "#", tooltip: project)) do %>
                <%= glyph.call(name) %>
                <span><%= project %></span>
              <% end %>
              <%= render(Shadcn::Sidebar::MenuAction::Component.new(show_on_hover: true, "aria-label": "More")) do %>
                <%= render(Shadcn::Icon::Component.new("more-horizontal")) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Shadcn::Sidebar::Footer::Component.new) do %>
      <%= render(Shadcn::Sidebar::Menu::Component.new) do %>
        <%= render(Shadcn::Sidebar::MenuItem::Component.new) do %>
          <%= render(Shadcn::DropdownMenu::Component.new(side: :top)) do |menu| %>
            <% menu.with_trigger(
                 class: Shadcn::Sidebar::MenuButton::Component.new(size: :lg).css_classes,
                 "data-size": "lg"
               ) do %>
              <%= render(Shadcn::Avatar::Component.new(class: "size-8 shrink-0 rounded-lg")) do |avatar| %>
                <% avatar.with_fallback { "SC" } %>
              <% end %>
              <div class="grid flex-1 text-left text-sm leading-tight">
                <span class="truncate font-medium">shadcn</span>
                <span class="truncate text-xs">m@example.com</span>
              </div>
              <%= render(Shadcn::Icon::Component.new("chevrons-up-down", class: "ml-auto")) %>
            <% end %>
            <% menu.with_menu_content(class: "w-56") do %>
              <%= render(Shadcn::DropdownMenu::Label::Component.new) { "m@example.com" } %>
              <%= render(Shadcn::DropdownMenu::Separator::Component.new) %>
              <% [ "Account", "Billing", "Notifications" ].each do |entry| %>
                <%= render(Shadcn::DropdownMenu::Item::Component.new) { entry } %>
              <% end %>
              <%= render(Shadcn::DropdownMenu::Separator::Component.new) %>
              <%= render(Shadcn::DropdownMenu::Item::Component.new) { "Log out" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# Inside the panel, last, exactly where upstream puts it: its `absolute`
        is meant to resolve against `sidebar-container`, and its
        `group-data-[side=left]:-right-4` against the panel's own `group`.
        Rendered as a sibling instead it positions against the page and draws a
        line straight through the icons. %>
    <%= render(Shadcn::Sidebar::Rail::Component.new) %>
  <% end %>

  <%= render(Shadcn::Sidebar::Inset::Component.new) do %>
    <div class="flex items-center gap-2 border-b p-2">
      <%= render(Shadcn::Sidebar::Trigger::Component.new) %>
      <%= render(Shadcn::Sidebar::Separator::Component.new(orientation: :vertical, class: "h-4")) %>
      <span class="text-sm font-medium">Dashboard</span>
    </div>
    <p class="p-4 text-sm text-muted-foreground">Page content.</p>
  <% end %>
<% end %>
