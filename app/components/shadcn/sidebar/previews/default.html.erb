<%# Eight of the family's 24 parts. The rest — Menu, Group, Sub and the leaves —
    are markup and follow.

    `open:` is what a Rails layout passes after reading the `sidebar_state`
    cookie the controller writes; here it takes its default. %>
<%= render(Shadcn::Sidebar::Provider::Component.new) do %>
  <%= render(Shadcn::Sidebar::Component.new) do %>
    <%= render(Shadcn::Sidebar::Header::Component.new) do %>
      <span class="px-2 text-sm font-medium">Acme</span>
    <% end %>

    <%= render(Shadcn::Sidebar::Content::Component.new) do %>
      <nav class="flex flex-col gap-1 p-2" aria-label="Main">
        <a href="#" class="rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent">Dashboard</a>
        <a href="#" class="rounded-md px-2 py-1.5 text-sm hover:bg-sidebar-accent">Settings</a>
      </nav>
    <% end %>

    <%= render(Shadcn::Sidebar::Footer::Component.new) do %>
      <span class="px-2 text-xs text-muted-foreground">v0.1.0</span>
    <% end %>
  <% end %>

  <%= render(Shadcn::Sidebar::Rail::Component.new) %>

  <%= render(Shadcn::Sidebar::Inset::Component.new) do %>
    <%= render(Shadcn::Sidebar::Trigger::Component.new) %>
    <p class="mt-4 text-sm text-muted-foreground">Page content.</p>
  <% end %>
<% end %>
