<%# Upstream's `variant` — the panel that floats away from the edge, and the one
    that insets the page beside it. `sidebar`, the default, is in the default
    preview; these two are not, and neither is a matter of colour: `floating`
    gives the panel its own rounded border and shadow, and `inset` pulls the
    page's own container in so the panel sits in the margin rather than against
    the frame.

    Two providers on one page, each with its own sidebar, which is the only way
    to see them beside each other. Every id the components generate is unique,
    so they do not collide. %>
<div class="flex flex-col gap-8">
  <% %i[floating inset].each do |variant| %>
    <div class="text-sm font-medium"><%= variant %></div>
    <div class="h-64 overflow-hidden rounded-lg border">
      <%= render(Shadcn::Sidebar::Provider::Component.new(class: "min-h-0")) do %>
        <%= render(Shadcn::Sidebar::Component.new(variant:, collapsible: :icon)) do %>
          <%= render(Shadcn::Sidebar::Content::Component.new) do %>
            <%= render(Shadcn::Sidebar::Group::Component.new) do %>
              <%= render(Shadcn::Sidebar::GroupLabel::Component.new) { "Workspace" } %>
              <%= render(Shadcn::Sidebar::Menu::Component.new) do %>
                <% [["search", "Search"], ["circle", "Projects"], ["check", "Done"]].each do |icon, label| %>
                  <%= render(Shadcn::Sidebar::MenuItem::Component.new) do %>
                    <%= render(Shadcn::Sidebar::MenuButton::Component.new(tooltip: label)) do %>
                      <%= render(Shadcn::Icon::Component.new(icon)) %>
                      <span><%= label %></span>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%= render(Shadcn::Sidebar::Inset::Component.new) do %>
          <div class="flex items-center gap-2 p-4">
            <%= render(Shadcn::Sidebar::Trigger::Component.new) %>
            <span class="text-sm text-muted-foreground">The page beside a <%= variant %> panel.</span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
