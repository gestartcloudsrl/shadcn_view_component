<%# Upstream's "Custom Separator": the separator draws a chevron when given
    nothing, and whatever it is given when it is. %>
<%= render(Shadcn::Breadcrumb::Component.new) do %>
  <%= render(Shadcn::Breadcrumb::List::Component.new) do %>
    <%= render(Shadcn::Breadcrumb::Item::Component.new) do %>
      <%= render(Shadcn::Breadcrumb::Link::Component.new(href: "#")) { "Home" } %>
    <% end %>
    <%= render(Shadcn::Breadcrumb::Separator::Component.new) { "/" } %>
    <%= render(Shadcn::Breadcrumb::Item::Component.new) do %>
      <%= render(Shadcn::Breadcrumb::Link::Component.new(href: "#")) { "Docs" } %>
    <% end %>
    <%= render(Shadcn::Breadcrumb::Separator::Component.new) { "/" } %>
    <%= render(Shadcn::Breadcrumb::Item::Component.new) do %>
      <%= render(Shadcn::Breadcrumb::Page::Component.new) { "Breadcrumb" } %>
    <% end %>
  <% end %>
<% end %>
